---
import Shuoshuo from "@components/shuoshuo/Shuoshuo.svelte";
import { profileConfig, shuoshuoConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
---

<MainGridLayout
  title={i18n(I18nKey.shuoshuo)}
  description={i18n(I18nKey.shuoshuoDescription)}
>
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-6 md:px-9 py-6 relative w-full">
      <!-- Page header -->
      <div class="mb-2">
        <h1 class="text-3xl font-bold text-90 mb-2">
          {i18n(I18nKey.shuoshuo)}
        </h1>
        <p class="text-75 text-sm mb-6">
          {i18n(I18nKey.shuoshuoDescription)}
        </p>
      </div>

      <Shuoshuo
        client:only="svelte"
        apiBaseUrl={shuoshuoConfig.apiBaseUrl}
        authorAvatar={profileConfig.avatar ?? "/favicon/favicon.png"}
        authorName={profileConfig.name}
      />
    </div>
  </div>
</MainGridLayout>
