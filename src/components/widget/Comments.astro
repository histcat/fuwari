<div id="tcomment"></div>

<script is:inline>
  var TWIKOO_ENV_ID = 'https://histcattwikoo.netlify.app/.netlify/functions/twikoo';
  var CDN = 'https://registry.npmmirror.com/twikoo/1.7.15/files/dist/twikoo.all.min.js';

  (function () {
    var DARK_STYLES =
      'html.dark .tk-comments,' +
      'html.dark .tk-comments-container,' +
      'html.dark .tk-comment,' +
      'html.dark .tk-content,' +
      'html.dark .tk-input,' +
      'html.dark .tk-preview,' +
      'html.dark .tk-comments-title,' +
      'html.dark .tk-comments-count,' +
      'html.dark .tk-nick,' +
      'html.dark .tk-nick-link,' +
      'html.dark .tk-meta,' +
      'html.dark .tk-submit,' +
      'html.dark .tk-action-link,' +
      'html.dark .tk-avatar,' +
      'html.dark .tk-row,' +
      'html.dark .tk-replies,' +
      'html.dark .tk-expand,' +
      'html.dark .tk-owo,' +
      'html.dark .tk-extras,' +
      'html.dark .tk-label,' +
      'html.dark .el-input__inner,' +
      'html.dark .el-input__wrapper,' +
      'html.dark .el-textarea__inner,' +
      'html.dark .OwO .OwO-logo,' +
      'html.dark .vemo,' +
      'html.dark .vcontent,' +
      'html.dark .vreply' +
      '{color:#d1d5db !important}' +
      'html.dark .tk-time,' +
      'html.dark .tk-row-actions,' +
      'html.dark .tk-action,' +
      'html.dark .tk-action-count,' +
      'html.dark .tk-admin,' +
      'html.dark .tk-badge' +
      '{color:#9ca3af !important}' +
      'html.dark .el-input__inner,' +
      'html.dark .el-textarea__inner' +
      '{background-color:#1f2937 !important;border-color:#4b5563 !important}' +
      'html.dark .el-textarea__inner:focus,' +
      'html.dark .el-input__inner:focus' +
      '{border-color:#6366f1 !important}' +
      'html.dark .tk-comment' +
      '{border-bottom-color:#374151 !important}';

    var twikooStyleEl = null;

    function updateDark() {
      var isDark = document.documentElement.classList.contains('dark');
      if (isDark && !twikooStyleEl) {
        twikooStyleEl = document.createElement('style');
        twikooStyleEl.id = 'twikoo-dark-styles';
        twikooStyleEl.textContent = DARK_STYLES;
        document.head.appendChild(twikooStyleEl);
      } else if (!isDark && twikooStyleEl) {
        twikooStyleEl.remove();
        twikooStyleEl = null;
      }
    }

    updateDark();
    new MutationObserver(updateDark).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });

    // Prevent Enter in Twikoo inputs from reloading the page
    document.addEventListener('keydown', function (e) {
      if (e.key !== 'Enter') return;
      var el = e.target;
      if (el.tagName === 'INPUT' && el.closest('#tcomment')) {
        e.preventDefault();
        e.stopImmediatePropagation();
        var form = el.closest('form');
        var btn =
          (form && form.querySelector('button[type="submit"], .el-button--primary')) ||
          document.querySelector('#tcomment button[type="submit"], #tcomment .el-button--primary');
        if (btn) btn.click();
      }
    }, true);

    // Load twikoo and init after load
    var script = document.createElement('script');
    script.src = CDN;
    script.onload = function () {
      twikoo.init({ envId: TWIKOO_ENV_ID, el: '#tcomment' });
    };
    document.head.appendChild(script);
  })();
</script>
